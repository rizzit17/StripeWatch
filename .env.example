# StripeWatch Environment Configuration
# LLM_PROVIDER can be: 'gemini', 'groq', 'ollama', or 'none' (deterministic template mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq configuration
# GROQ_API_KEY=your_groq_api_key_here

# Embedding & Chroma settings (defaults in config.py)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
